# Artix — Environment Variables
# Copy this file to .env.local (Vite convention) and fill in your own Supabase project values.
# These are the only two environment variables the frontend actually reads (verified against
# every import.meta.env.* reference in src/) — do not add speculative variables here without
# confirming the code actually uses them.

# Your Supabase project's API URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase project's publishable/anon key (Project Settings -> API -> anon public key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Note: Server-side secrets (STRIPE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, etc.) are NOT
# listed here because they belong to Supabase Edge Functions, not this frontend app, and
# must be set via `supabase secrets set` or the Supabase Dashboard — never in a client-side
# .env file, since anything prefixed VITE_ is bundled into the public build output.
